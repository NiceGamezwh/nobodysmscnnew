# Veeto Bearer — 仅供非用户对接的系统/管理用途（如脚本）。用户对接/对接管理不会回退到此值
# 正常流程：登录短信 api账号 后，服务端从 Sepolia 合约按账号查 Bearer；无链上 Bearer 则对接失败
VEETO_BEARER=

# Sepolia 明文 Bearer 注册合约（公开可读）
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
VEETO_BEARER_CONTRACT=0x668abf17783ADb0F26cdD9049736C6954a6378CF
